# ================================================================
# Plantilla de variables de entorno — Arquitectura Hexagonal PHP 8.3
# Entidades: Usuario (común) + Gasto (Ejercicio #6)
# Copiar como .env para ejecución local: cp .env.example .env
# ================================================================

APP_ENV=local
APP_DEBUG=true

# Motor de persistencia:
#   auto   -> Usa MySQL si está disponible y cae de forma segura a memoria si no hay servidor activo
#   mysql  -> Fuerza conexión estricta a MySQL (local o nube)
#   memory -> Usa adaptadores InMemory (útil para pruebas rápidas y contenedores sin BD externa)
DB_DRIVER=auto

# Base de datos MySQL (Local o Nube: Aiven / Railway / Clever Cloud / TiDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL_CA=

# Correo electrónico (SMTP)
# Si SMTP_USERNAME está vacío o conserva el valor de ejemplo, EmailSenderService
# registra el correo HTML en storage/logs/emails/ sin interrumpir el flujo CRUD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=email_que_envia@proveedor.com
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_ADDRESS=email_que_envia@proveedor.com
SMTP_FROM_NAME="Sistema Control de Usuarios y Gastos"
SMTP_STRICT=false

# Transporte opcional por HTTPS (Puerto 443) para planes Cloud Free (ej. Render Free)
# donde los puertos TCP 25/465/587 están bloqueados por firewall del proveedor:
BREVO_API_KEY=
RESEND_API_KEY=

# Adaptadores secundarios de Infraestructura (Cache, Colas y API REST externa)
CACHE_TTL_SECONDS=120
TAX_API_URL=