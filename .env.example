# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Arquitectura Hexagonal, DDD y CQRS PHP 8.3
# Entidades: Usuario (Común) + Gasto (Ejercicio #6)
# Copiar como `.env` en desarrollo local: cp .env.example .env
# SEGURIDAD OWASP: Nunca subir el archivo `.env` real con secretos al repositorio.
# ==============================================================================

APP_ENV=local
APP_DEBUG=false

# Motor de persistencia:
#   auto   -> Usa MySQL si está disponible y degrada limpiamente a memoria si no hay servidor activo
#   mysql  -> Fuerza conexión estricta a MySQL (local o Cloud Alwaysdata/Aiven/Railway)
#   memory -> Usa adaptadores InMemory (ideal para pruebas unitarias y CI/CD)
DB_DRIVER=auto

# Base de datos MySQL (Local o Nube: Alwaysdata / Aiven / Railway / TiDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL_CA=

# Correo electrónico (SMTP)
# Nota: Si existe la tabla `configuracion_smtp` en MySQL, el sistema carga las
# credenciales dinámicamente desde la BD (igual que en el módulo Spring Boot),
# usando estas variables como respaldo secundario.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=email_que_envia@proveedor.com
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_ADDRESS=email_que_envia@proveedor.com
SMTP_FROM_NAME="Sistema Control de Usuarios y Gastos"
SMTP_STRICT=false

# Transporte opcional por HTTPS (Puerto 443) para planes Cloud Free (ej. Render Free)
# donde los puertos salientes TCP 25/465/587 están restringidos por el proveedor.
# También pueden configurarse en caliente desde el panel Admin (?route=smtp.config):
EMAIL_HTTPS_WEBHOOK_URL=
EMAIL_HTTPS_WEBHOOK_TOKEN=
EMAIL_HTTPS_FROM_ADDRESS=
BREVO_API_KEY=
RESEND_API_KEY=

# Adaptadores secundarios de Infraestructura (Cache, Colas y API REST externa)
CACHE_TTL_SECONDS=120
TAX_API_URL=

# Seguridad API RESTful — Autenticación Stateless JWT (RFC 7519 HS256 / HMAC-SHA256)
# Si JWT_SECRET se deja vacío en desarrollo, SecurityGuard genera automáticamente una
# llave criptográfica aleatoria de 256 bits en storage/cache/jwt_secret.key (ignorada en Git).
# En producción Cloud se recomienda definir una cadena aleatoria >= 32 caracteres:
JWT_SECRET=
JWT_TTL_SECONDS=3600
CORS_ALLOWED_ORIGIN=*