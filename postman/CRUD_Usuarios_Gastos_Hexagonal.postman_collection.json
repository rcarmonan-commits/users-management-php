{
  "info": {
    "_postman_id": "6f8a92c1-4d7e-4b3a-9c61-060606060606",
    "name": "CRUD Usuarios + Ejercicio #6 Gasto — Hexagonal DDD CQRS PHP",
    "description": "Colección oficial de pruebas end-to-end para la entidad común Usuario y la entidad asignada #6 Gasto (fecha, valorTotalSinIVA, ivaTotal, valorTotalConIVA, nombreUsuario, lugar, descripcion).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "createdUserId", "value": "" },
    { "key": "createdGastoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Diagnóstico y Parámetros",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Success true', () => pm.expect(body.success).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "Indicadores Tributarios (Adaptador REST)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tax-indicators"
          }
        }
      ]
    },
    {
      "name": "2. Autenticación y Entidad Común Usuario (CRUDL)",
      "item": [
        {
          "name": "Login Administrador Base",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login exitoso 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@crud.com\",\n  \"password\": \"Admin12345\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Crear Usuario (Command)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario creado 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('createdUserId', json.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rosary Carmona\",\n  \"email\": \"rcarmonan@unicartagena.edu.co\",\n  \"password\": \"Cartagena2026\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Listar Usuarios (Query)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Consultar Usuario por ID (Query)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          }
        },
        {
          "name": "Actualizar Usuario sin cambiar clave (Command)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rosary Eilyn Carmona Navarro\",\n  \"email\": \"rcarmonan@unicartagena.edu.co\",\n  \"password\": \"\",\n  \"role\": \"ADMIN\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          }
        },
        {
          "name": "Eliminar Usuario (Command)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          }
        }
      ]
    },
    {
      "name": "3. Ejercicio #6 — Entidad Gasto (CRUDL + Reglas DDD)",
      "item": [
        {
          "name": "Crear Gasto Válido (Command)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gasto creado 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('createdGastoId', json.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-10-20\",\n  \"valorTotalSinIVA\": 200000,\n  \"ivaTotal\": 38000,\n  \"valorTotalConIVA\": 238000,\n  \"nombreUsuario\": \"Administrador\",\n  \"lugar\": \"Ferretería El Constructor Cartagena\",\n  \"descripcion\": \"Compra de cableado estructurado categoría 6A para laboratorio\"\n}"
            },
            "url": "{{baseUrl}}/api/gastos"
          }
        },
        {
          "name": "Validar Invariante Contable IVA Inválido (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rechaza inconsistencia de IVA con 422', () => pm.response.to.have.status(422));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-10-20\",\n  \"valorTotalSinIVA\": 100000,\n  \"ivaTotal\": 19000,\n  \"valorTotalConIVA\": 150000,\n  \"nombreUsuario\": \"Administrador\",\n  \"lugar\": \"Almacén Éxito\",\n  \"descripcion\": \"Intento con suma de IVA inconsistente\"\n}"
            },
            "url": "{{baseUrl}}/api/gastos"
          }
        },
        {
          "name": "Listar Gastos y Sumatorias (Query)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/gastos"
          }
        },
        {
          "name": "Consultar Gasto por ID (Query)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/gastos/{{createdGastoId}}"
          }
        },
        {
          "name": "Actualizar Gasto (Command)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-10-22\",\n  \"valorTotalSinIVA\": 300000,\n  \"ivaTotal\": 57000,\n  \"valorTotalConIVA\": 357000,\n  \"nombreUsuario\": \"Administrador\",\n  \"lugar\": \"Ferretería El Constructor Cartagena\",\n  \"descripcion\": \"Compra ampliada de cableado estructurado y conectores RJ45\"\n}"
            },
            "url": "{{baseUrl}}/api/gastos/{{createdGastoId}}"
          }
        },
        {
          "name": "Eliminar Gasto (Command)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/gastos/{{createdGastoId}}"
          }
        }
      ]
    }
  ]
}